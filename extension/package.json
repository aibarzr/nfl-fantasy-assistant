{
  "name": "nfl-fantasy-assistant-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && tsc -p tsconfig.build.json && node scripts/copy-manifest.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/chrome": "0.2.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
